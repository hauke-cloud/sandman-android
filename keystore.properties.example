# Copy to keystore.properties (git-ignored) or set the matching environment
# variables. Every build type is signed with this key, so an APK from this
# machine always installs over the one already on the phone.
#
#   storeFile      -> SANDMAN_KEYSTORE_FILE
#   storePassword  -> SANDMAN_KEYSTORE_PASSWORD
#   keyAlias       -> SANDMAN_KEY_ALIAS
#   keyPassword    -> SANDMAN_KEY_PASSWORD
#
# Run hack/create-keystore.sh to generate the key and this file.

storeFile=~/.config/hauke-cloud/sandman-android/release.jks
storePassword=change-me
keyAlias=sandman
keyPassword=change-me
